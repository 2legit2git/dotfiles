{
  "autosu": true,
  "clipboard": "terminal",
  "colorscheme": "monokai",
  "fmtonsave": true,
  "format": true,
  "hlsearch": true,
  "mkparents": true,
  "prettier.prettierPath": "/usr/local/bin/prettier",
